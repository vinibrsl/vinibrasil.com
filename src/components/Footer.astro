---
import { SITE_TITLE } from "../consts";
import Divider from "./Divider.astro";
const bornYear = 1999;
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-20 w-full max-w-measure pb-12 text-center font-display text-muted">
  <Divider class="mb-10" />
  <p class="m-0 mb-4 text-xs tracking-widest text-fg uppercase">{SITE_TITLE}</p>
  <p class="mx-auto my-0 max-w-120 text-xs leading-[1.85] tracking-wide text-pretty uppercase [font-feature-settings:normal] [&_a]:text-fg-soft">
    you can find me on{" "}
    <a href="https://github.com/vinibrsl" target="_blank" rel="me noopener">
      github
    </a>
    ,{" "}
    <a
      href="https://www.linkedin.com/in/vinicius-brasil/"
      target="_blank"
      rel="me noopener"
    >
      linkedin
    </a>
    , and{" "}
    <a href="https://unsplash.com/@vinib" target="_blank" rel="me noopener">
      unsplash
    </a>{" "}
    (where i post the occasional photo), or just{" "}
    <a href="mailto:vini@hey.com">email me</a>. and if you&rsquo;re old-school,
    the blog has an <a href="/rss.xml">rss feed</a>.
  </p>
  <p class="m-0 mt-6 text-xs tracking-wider [font-feature-settings:normal]">
    © {bornYear}&ndash;{year}
  </p>
</footer>
