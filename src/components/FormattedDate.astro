---
interface Props {
  date: Date;
  terminal?: boolean;
}
const { date, terminal = false } = Astro.props;
---

<time class={terminal ? undefined : "label"} datetime={date.toISOString()}>
  {
    terminal
      ? date.toISOString().slice(0, 10)
      : date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
  }
</time>
