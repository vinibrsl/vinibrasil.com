---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Caption text after the FIG. tag; falls back to the alt text. */
  caption?: string;
  /** Extra classes on the <figure> (e.g. layout modifiers). */
  class?: string;
  loading?: "lazy" | "eager";
}

const {
  src,
  alt,
  caption,
  class: className,
  loading,
} = Astro.props;
const image = {
  src,
  alt,
  loading,
  sizes: "(min-width: 672px) 608px, calc(100vw - clamp(40px, 10vw, 64px))",
  quality: src.format === "png" ? 90 : undefined,
};
---

<figure class:list={["fig", className]}>
  <Image {...image} />
  <figcaption>
    <slot>{caption ?? alt}</slot>
  </figcaption>
</figure>
