---
import { SITE_TITLE, NAV_LINKS } from "../consts";
import Divider from "./Divider.astro";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="mx-auto mb-8 flex w-full max-w-measure flex-wrap items-end justify-between gap-x-6 gap-y-3 pt-9">
  <a
    href="/"
    class="inline-flex items-center gap-[0.5ch] font-display text-xl leading-none tracking-wide text-accent no-underline uppercase"
  >
    {SITE_TITLE}
    <span
      class="h-[0.9em] w-[0.5em] bg-current"
      aria-hidden="true"
    ></span>
  </a>
  <nav class="flex gap-6 pb-1" aria-label="Primary">
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class:list={[
          "font-display text-xs tracking-wider no-underline uppercase",
          isActive(link.href) ? "text-accent" : "text-muted",
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <Divider class="mt-4 basis-full" />
</header>
