---
import { SITE_TITLE, NAV_LINKS } from "../consts";
import Divider from "./Divider.astro";
import TerminalLink from "./TerminalLink.astro";
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="mx-auto mb-10 flex w-full max-w-measure flex-wrap items-center justify-between gap-x-4 gap-y-6 pt-9 sm:mb-12">
  <a
    href="/"
    class="inline-flex items-center gap-[0.5ch] font-display text-xl leading-none tracking-wide text-accent no-underline uppercase"
  >
    {SITE_TITLE}
    <span
      class="h-[0.9em] w-[0.5em] bg-current"
      aria-hidden="true"
    ></span>
  </a>
  <nav class="flex flex-wrap gap-x-2" aria-label="Primary">
    {NAV_LINKS.map((link) => (
      <TerminalLink
        href={link.href}
        active={isActive(link.href)}
      >
        {link.label}
      </TerminalLink>
    ))}
  </nav>
  <Divider class="basis-full" />
</header>
