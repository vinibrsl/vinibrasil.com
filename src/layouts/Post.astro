---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import { SITE_TITLE } from "../consts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate } = post.data;
---

<Base
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  updatedTime={updatedDate}
  image={`/og/${post.id}.png`}
  imageAlt={`${title} — ${SITE_TITLE}`}
  markdown={`/${post.id}.md`}
>
  <article class="post">
    <header class="mb-10">
      <a href="/" class="label mb-6 inline-block no-underline hover:text-accent">← Back to posts</a>
      <h1>{title}</h1>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Base>
