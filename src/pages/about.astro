---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing about page");
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description} markdown="/about.md">
  <article class="post log-page">
    <header class="post-header"><h1 class="page-title">{page.data.title}</h1></header>
    <div class="post-body"><Content /></div>
  </article>
</Base>
