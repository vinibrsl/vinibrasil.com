---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Not found" description="That page doesn't exist.">
  <section class="mt-16 text-center">
    <div class="font-display text-7xl leading-none tracking-wide text-accent sm:text-9xl">
      404
    </div>
    <p class="mx-auto my-7 max-w-[30rem] text-lg leading-normal text-fg-soft [text-wrap:pretty] sm:mb-8 sm:text-xl">
      This one moved, was renamed, or never made it to print.
    </p>
    <p class="m-0">
      <a href="/">
        ← Back to the homepage
      </a>
    </p>
  </section>
</Base>
